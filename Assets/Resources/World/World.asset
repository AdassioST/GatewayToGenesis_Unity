    behavior:
      stepAt: 0.34
      huntHarm: 0.06
      habitatHarm: 0.6
      coexist: 0.04
      coexistCap: 0.4
      spread: 0.35
      memoryKept: 0.3
      warySpoils: 0.6
      hostileDanger: 0.35
      hostileReach: 1
    rhythm:
      echoes:
      - name: Echo of Resonance
        summary: the herds give birth and the creatures forgive most readily, attuned to the world opening its song
        growth: 1.6
        detritivoreGrowth: 1
        dispersal: 0.6
        predation: 0.8
        yields: 1
        harm: 1
        ease: 2
        hungerDanger: 0
        plagues: 0.6
      - name: Echo of Crescendo
        summary: the creatures range widest and yield the most, and predators hunt hardest
        growth: 1.2
        detritivoreGrowth: 1
        dispersal: 1.4
        predation: 1.2
        yields: 1.3
        harm: 1
        ease: 1
        hungerDanger: 0
        plagues: 0.8
      - name: Echo of Dissonance
        summary: herds scatter and migrate, decay feeds the decomposers, and a hunt fractures trust the deepest
        growth: 0.8
        detritivoreGrowth: 1.8
        dispersal: 1.4
        predation: 1
        yields: 1
        harm: 1.5
        ease: 0.5
        hungerDanger: 0
        plagues: 1.8
      - name: Echo of Silence
        summary: the creatures lie dormant and few are born, and hungry predators stray toward settlements
        growth: 0.4
        detritivoreGrowth: 0.6
        dispersal: 0.6
        predation: 1
        yields: 0.7
        harm: 1
        ease: 1
